def general_menu():
    print_header("GENERAL-PURPOSE MATH FUNCTIONS")
    print("""1. Compute ceil, floor, and trunc of a value
             2. Compute a factorial
             3. Compute the hypotenuse of a right triangle
             0. Back to Main Menu
         """)

    choice = safe_input("Enter your choice: ").strip()
    
    if choice == "1":
        val = get_float("Enter a floating-point value: ")
        print("Ceil:", math.ceil(val))
        print("Floor:", math.floor(val))
        print("Trunc:", math.trunc(val))

    elif choice == "2":
        n = get_int("Enter a non-negative integer: ")
        if n < 0:
            print("Factorial is not defined for negative numbers.")
        else:
            print(f"Factorial of {n} is:", math.factorial(n))

    elif choice == "3":
        a = get_float("Enter side a: ")
        b = get_float("Enter side b: ")
        print("Hypotenuse:", math.hypot(a, b))

    elif choice == "0":
        return
    else:
        print("\nInvalid choice.")

    pause()


