import math

print("--- Task 1: Angle Explorer ---")
angle_degrees = 60
angle_radians = math.radians(angle_degrees)
print(f"Angle in radians:{angle_radians:.4}")
print(f"sin -> {math.sin(angle_radians):.4}")
print(f"cos -> {math.cos(angle_radians):.4}")
print(f"tan -> {math.tan(angle_radians):.4}")

print()

