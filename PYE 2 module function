import math

print("--- Task 3: Rounding Showdown ---")
value = -7.8
print(f"ceil -> {math.ceil(value)}")
print(f"floor -> {math.floor(value)}")
print(f"trunc -> {math.trunc(value)}")

#The floor() it rounds the number down to the nearest integer, while the trunc() it removes the decimal part without rounding the number up or down to the nearest integer.

print()

